<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"></head>
<body style="font-family:Inter,Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;color:#1e293b">
  <div style="text-align:center;margin-bottom:32px">
    <span style="font-size:1.5rem;font-weight:700">Artisan<span style="color:#f97316">Portal</span></span>
  </div>
  <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:16px;margin-bottom:24px">
    <p style="margin:0;color:#166534;font-weight:600">✅ Document signé électroniquement</p>
  </div>
  <h2 style="font-size:1.1rem">{{ document_label }} a été signé</h2>
  <table style="width:100%;border-collapse:collapse;margin:16px 0">
    <tr><td style="padding:8px 0;color:#64748b;width:140px">Document</td><td style="padding:8px 0;font-weight:600">{{ document_label }}</td></tr>
    <tr><td style="padding:8px 0;color:#64748b">Signataire</td><td style="padding:8px 0">{{ signer_name }}</td></tr>
    <tr><td style="padding:8px 0;color:#64748b">Date</td><td style="padding:8px 0">{{ signed_at }}</td></tr>
    <tr><td style="padding:8px 0;color:#64748b">Chantier</td><td style="padding:8px 0">{{ chantier_title }}</td></tr>
  </table>
  <p style="color:#64748b;font-size:0.875rem">La signature a été enregistrée avec l'adresse IP du signataire pour valeur probante.</p>
</body>
</html>
