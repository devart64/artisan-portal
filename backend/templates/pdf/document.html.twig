<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ document.label }}</title>
<style>
  body { font-family: DejaVu Sans, Arial, sans-serif; color: #1a1a1a; font-size: 13px; margin: 0; padding: 0; }
  .header { background: {{ brand_color }}; color: white; padding: 32px 40px; }
  .header h1 { margin: 0; font-size: 22px; font-weight: bold; }
  .header p { margin: 4px 0 0; opacity: 0.85; font-size: 13px; }
  .body { padding: 32px 40px; }
  .section { margin-bottom: 24px; }
  .section-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #888; margin-bottom: 8px; border-bottom: 1px solid #eee; padding-bottom: 4px; }
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .info-label { color: #666; font-size: 11px; }
  .info-value { font-weight: 600; font-size: 13px; margin-top: 2px; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; }
  .badge-signed { background: #d1fae5; color: #065f46; }
  .badge-pending { background: #fef3c7; color: #92400e; }
  .signature-box { border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-top: 8px; }
  .footer { position: fixed; bottom: 0; left: 0; right: 0; padding: 12px 40px; font-size: 10px; color: #999; border-top: 1px solid #eee; text-align: center; }
</style>
</head>
<body>

<div class="header">
  <h1>{{ tenant_name }}</h1>
  <p>{{ document.label }}</p>
</div>

<div class="body">

  <div class="section">
    <div class="section-title">Informations du chantier</div>
    <div class="info-grid">
      <div>
        <div class="info-label">Chantier</div>
        <div class="info-value">{{ chantier_title }}</div>
      </div>
      <div>
        <div class="info-label">Client</div>
        <div class="info-value">{{ client_name }}</div>
      </div>
      {% if chantier_address %}
      <div>
        <div class="info-label">Adresse</div>
        <div class="info-value">{{ chantier_address }}</div>
      </div>
      {% endif %}
    </div>
  </div>

  <div class="section">
    <div class="section-title">Document</div>
    <div class="info-grid">
      <div>
        <div class="info-label">Type</div>
        <div class="info-value">{{ document.type.value|capitalize }}</div>
      </div>
      <div>
        <div class="info-label">Statut</div>
        <div class="info-value">
          {% if document.signedAt %}
            <span class="badge badge-signed">Signé</span>
          {% else %}
            <span class="badge badge-pending">En attente</span>
          {% endif %}
        </div>
      </div>
      <div>
        <div class="info-label">Créé le</div>
        <div class="info-value">{{ document.createdAt|date('d/m/Y') }}</div>
      </div>
    </div>
  </div>

  {% if document.signedAt %}
  <div class="section">
    <div class="section-title">Signature électronique</div>
    <div class="signature-box">
      <div class="info-grid">
        <div>
          <div class="info-label">Signataire</div>
          <div class="info-value">{{ document.signerName }}</div>
        </div>
        <div>
          <div class="info-label">Signé le</div>
          <div class="info-value">{{ document.signedAt|date('d/m/Y à H:i') }}</div>
        </div>
      </div>
      <p style="margin-top:12px;color:#666;font-size:11px">
        Ce document a été signé électroniquement. La signature est légalement valide conformément au règlement eIDAS.
      </p>
    </div>
  </div>
  {% endif %}

</div>

<div class="footer">
  {{ tenant_name }} · Généré le {{ 'now'|date('d/m/Y à H:i') }} · Artisan Portal
</div>

</body>
</html>
